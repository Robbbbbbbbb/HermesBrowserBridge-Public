{
  "manifest_version": 3,
  "name": "Hermes Browser Bridge",
  "version": "0.1.0",
  "description": "Lets Hermes see and act in the tabs you attach \u2014 with your real logged-in session, under your control.",
  "minimum_chrome_version": "116",
  "permissions": [
    "debugger",
    "tabs",
    "webNavigation",
    "tabGroups",
    "cookies",
    "scripting",
    "storage",
    "contextMenus",
    "notifications",
    "offscreen",
    "alarms",
    "downloads",
    "webRequest",
    "webRequestAuthProvider",
    "privacy"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Hermes Browser Bridge"
  },
  "options_ui": {
    "page": "options.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "commands": {
    "stop-hermes": {
      "suggested_key": {
        "default": "Alt+Shift+S",
        "mac": "Alt+Shift+S"
      },
      "description": "Stop Hermes: release every shared tab and pause sharing"
    }
  }
}
